{
	"version": "0.2.0",
	"configurations": [
		{
			"name": "Fusion: Run open file",
			"type": "node",
			"request": "attach",
			"websocketAddress": "ws://localhost:9229/id-${file}",
			"trace": true,
			"continueOnAttach": true,
			"sourceMaps": true,
			"remoteRoot": null,
			"localRoot": "${workspaceFolder}"
		},
		{
			"name": "Fusion: Run main module",
			"type": "node",
			"request": "attach",
			"websocketAddress": "ws://localhost:9229/id-${workspaceFolder}/${workspaceFolderBasename}.ts",
			"trace": true,
			"continueOnAttach": true,
			"sourceMaps": true,
			"remoteRoot": null,
			"localRoot": "${workspaceFolder}"
		}
	]
}
